# ==============================================================================
# Example Terraform Variables - Copy to terraform.tfvars
# ==============================================================================

project_id             = "hhp-staging"
region                 = "us-central1"
environment            = "staging"
vpc_name               = "hhp-prod-vpc"
subnet_name            = "hhp-subnet-app"
subnet_cidr            = "10.10.1.0/24"
domain_name            = "hospital.dubemphilservices.online"
api_subdomain          = "hospitalapi.dubemphilservices.online"
app_image              = "us-docker.pkg.dev/cloudrun/container/hello"
db_tier                = "db-custom-2-7680" # Cost-effective: 2 vCPU, 7.5GB RAM
db_name                = "dental_management_system"
db_user                = "hospital_app_user"
enable_cloud_armor     = true
audit_retention_days   = 365
github_backend_repo    = "Dubemphil/Hospital_backend_app"
github_frontend_repo   = "Dubemphil/Hospital_frontend_app"
