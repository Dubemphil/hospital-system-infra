# ==============================================================================
# Example Variables File: terraform.tfvars.example
# Copy to terraform.tfvars and customize for your environment
# ==============================================================================

aws_region  = "us-east-1"
environment = "staging"
project_name = "hospital-system"

# Networking
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# Database Configuration
db_name                  = "dental_management_system"
db_username              = "hospital_app_user"
db_instance_class        = "db.t4g.micro" # Cost-effective for dev/staging; use db.m6i.large for prod
db_multi_az              = false          # Set to true for production high availability
db_backup_retention_days = 7
db_skip_final_snapshot   = true           # Set to false for production deletion protection

# ECS Fargate Sizing
backend_container_port = 8080
ecs_task_cpu           = 512              # 0.5 vCPU
ecs_task_memory        = 1024             # 1024 MiB
ecs_desired_count      = 2                # High availability across 2 AZs

# GitHub Actions OIDC Integration
github_org           = "Dubemphil"
github_backend_repo  = "hospital-system-backend"
github_frontend_repo = "hospital-system-frontend"
github_infra_repo    = "hospital-system-infra"

